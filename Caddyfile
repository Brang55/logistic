# SITE_ADDRESS: your domain (e.g. app.example.com) for automatic HTTPS, or ":80" for plain HTTP.
{
	servers {
		# Behind a shared edge proxy (docs/DEPLOY.md), its X-Forwarded-For/-Proto are kept, so the API sees
		# the visitor's IP (rate limits) and HTTPS (Secure gate cookie). Direct visitors have public IPs and
		# are never trusted.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The driver app needs the microphone for voice commands (HTTPS only in browsers).
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}

	# Site password gate: without the cookie set by POST /api/gate (see docs/DEPLOY.md), pages get
	# gate.html and the API gets 403. The telematics provider posts its webhook without the cookie.
	# Fails closed if SITE_GATE_TOKEN is ever empty. Must stay above the other handle blocks.
	@locked {
		not path /api/gate /api/telematics/webhook /favicon.png
		not expression `{http.request.cookie.site_gate} == "{$SITE_GATE_TOKEN}" && "{$SITE_GATE_TOKEN}" != ""`
	}
	handle @locked {
		@lockedApi path /api/* /socket.io/*
		handle @lockedApi {
			respond "Site password required" 403
		}
		handle {
			root * /srv
			header Cache-Control no-store
			header X-Robots-Tag noindex
			rewrite * /gate.html
			file_server
		}
	}

	@api path /api/* /socket.io/*
	handle @api {
		reverse_proxy api:3000 {
			# Only the visitor's IP: the API trusts one proxy hop, and Caddy would otherwise append the edge's.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Single-page app: unknown paths serve index.html. Built assets have hashed names, so they are cached
		# long-term; everything else (index.html above all) is revalidated, so a reload after a deploy gets it.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
