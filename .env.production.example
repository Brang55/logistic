# Copy to .env.production on the server and fill in. Never commit the real file.

# Domain served by Caddy with automatic HTTPS (DNS A record must point at the server).
SITE_ADDRESS=app.example.com
PUBLIC_URL=https://app.example.com

# Database password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LOGIN_RATE_LIMIT=10

# Mapbox: public pk. token for map tiles in the browser, secret sk. token for routing on the server.
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_SECRET_TOKEN=

# First admin login (created by: docker compose ... exec api node dist/db/create-admin.js)
OWNER_EMAIL=
OWNER_PASSWORD=

# "simulator" for a demo server; empty when real telematics post to the webhook.
TELEMATICS_PROVIDER=
SIMULATOR_SPEEDUP=30
TELEMATICS_WEBHOOK_SECRET=

# Optional: Claude for multilingual voice commands
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-opus-5-5

TRAFFIC_MONITOR_INTERVAL_MS=300000
LOADBOARD_SYNC_INTERVAL_MS=600000
NEXT_PICKUP_MAX_KM=1500
# Set to true only on a demo server where `demo:reset` may wipe data.
ALLOW_DEMO_RESET=false
