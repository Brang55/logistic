DATABASE_URL=postgres://logistic:logistic@localhost:5432/logistic
PORT=3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Server-side Mapbox token (secret, sk.*) used for routing calls in later phases
MAPBOX_SECRET_TOKEN=
REDIS_URL=redis://localhost:6379
# "simulator" drives assigned trucks along their routes for demos; leave empty for real telematics only
TELEMATICS_PROVIDER=simulator
SIMULATOR_SPEEDUP=30
# Shared secret telematics providers send in the x-telematics-secret header
TELEMATICS_WEBHOOK_SECRET=
