DATABASE_URL=postgres://logistic:logistic@localhost:5432/logistic
PORT=3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Server-side Mapbox token (secret, sk.*): address geocoding, and routing when no TomTom key is set
MAPBOX_SECRET_TOKEN=
# TomTom key for truck routing (truck dimensions, weight, axles) and the truck drive-time matrix
TOMTOM_API_KEY=
# "tomtom" or "mapbox"; empty picks TomTom when TOMTOM_API_KEY is set
ROUTING_PROVIDER=
REDIS_URL=redis://localhost:6379
# "simulator" drives assigned trucks along their routes for demos; leave empty for real telematics only
TELEMATICS_PROVIDER=simulator
SIMULATOR_SPEEDUP=30
# Shared secret telematics providers send in the x-telematics-secret header
TELEMATICS_WEBHOOK_SECRET=
NEXT_PICKUP_MAX_KM=1500
# Traffic re-check interval for active trips (0 disables the background monitor)
TRAFFIC_MONITOR_INTERVAL_MS=300000
# An active trip's route is reused until its stops change, the truck leaves it by more than
# ROUTE_OFF_ROUTE_M, or it is older than these (driving / parked); keeps routing bills down
ROUTE_REFRESH_MOVING_MS=900000
ROUTE_REFRESH_PARKED_MS=3600000
ROUTE_OFF_ROUTE_M=500
# Set to false to leave picked-up/delivered to the driver app while simulating
SIMULATOR_AUTO_STATUS=true
# Optional owner (admin) account created by `npm run db:seed`
OWNER_EMAIL=
OWNER_PASSWORD=
# Voice commands: with ANTHROPIC_API_KEY set, Claude parses commands; otherwise a built-in phrase parser is used
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-opus-5-5
# Dispatcher assistant (typed and spoken commands for staff); also needs ANTHROPIC_API_KEY
ASSISTANT_MODEL=claude-opus-5-5
# Load boards: how often booked loads are auto-imported (0 disables)
LOADBOARD_SYNC_INTERVAL_MS=600000

# Uploaded truck/trailer document scans (default: server/uploads)
UPLOAD_DIR=
COMPLIANCE_CHECK_INTERVAL_MS=21600000
